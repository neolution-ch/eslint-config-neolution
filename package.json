{
  "name": "@collana-solutions/eslint-config",
  "version": "3.1.0",
  "description": "This package provides the ESLint config of collana solutions as an extensible shared config.",
  "homepage": "https://github.com/collana-solutions/eslint-config#readme",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc && eslint --cache",
    "prepack": "pnpm run build",
    "upgradeAll": "npm-check-updates --packageFile ./package.json -u",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/eslint-config"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.26",
    "@typescript-eslint/utils": "^8.70.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-only-error": "^1.0.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "eslint": "^9.38.0 || ^10.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": ">=3.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-prettier": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^25.9.8",
    "eslint": "^10.8.0",
    "eslint-plugin-prettier": "^5.5.6",
    "npm-check-updates": "^19.6.6",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
