{
  "name": "@neolution-ch/eslint-config-neolution",
  "version": "3.1.0",
  "description": "This package provides Neolution's .eslintrc as an extensible shared config.",
  "homepage": "https://github.com/neolution-ch/eslint-config-neolution",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "lint": "yarn tsc && eslint --cache",
    "prepack": "yarn tsc",
    "upgradeAll": "npm-check-updates --packageFile ./package.json -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolution-ch/eslint-config-neolution"
  },
  "license": "MIT",
  "author": "Neolution",
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.27.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^7.0.2",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsdoc": "^65.3.4",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-only-error": "^1.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^78.0.0",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "eslint": "^10.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": ">=3.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-prettier": {
      "optional": true
    },
    "prettier": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^8.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
