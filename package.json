{
  "name": "@neolution-ch/eslint-config-neolution",
  "version": "2.6.0",
  "description": "This package provides Neolution's .eslintrc as an extensible shared config.",
  "homepage": "https://github.com/neolution-ch/eslint-config-neolution",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "lint": "yarn tsc && eslint --cache",
    "prepack": "yarn tsc",
    "upgradeAll": "npm-check-updates --packageFile ./package.json -u"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neolution-ch/eslint-config-neolution"
  },
  "license": "MIT",
  "author": "Neolution",
  "dependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^15.5.26",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-cypress": "^6.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-only-error": "^1.0.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "eslint": "^9.38.0 || ^10.0.0",
    "prettier": ">=3.0.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@release-it/keep-a-changelog": "^7.1.0",
    "@types/node": "^25.9.8",
    "eslint": "^10.8.0",
    "npm-check-updates": "^19.6.6",
    "prettier": "^3.9.9",
    "release-it": "^19.2.4",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
